; Independent tactics prototype. Open this file in Godot 4.6.1.
config_version=5

[application]
config/name="三国 · 战术试验场"
run/main_scene="res://levels/encounter.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"

[input]
camera_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
camera_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
camera_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
camera_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
stop_order={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":88)]}
focus_selection={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
clear_selection={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
select_all={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194306)]}
reset_sandbox={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
tactical_pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
select_squad_1={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":49)]}
select_squad_2={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":50)]}
select_squad_3={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":51)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.09, 0.12, 0.13, 1)
textures/default_filters/use_nearest_mipmap_filter=false
