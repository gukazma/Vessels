; 每帧 48x48，4列 x 4行
; Row 0 (y=0)   : Down  (front)   col0-1=idle, col2-3=walk
; Row 1 (y=48)  : Up    (back)    col0-1=idle, col2-3=walk
; Row 2 (y=96)  : Left            col0-1=idle, col2-3=walk
; Row 3 (y=144) : Right           col0-1=idle, col2-3=walk

