; Edit gameplay bindings in Project Settings > Input Map.
config_version=5

[application]
config/name="Vessels — Outbreak"
run/main_scene="res://levels/movement_yard.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_backward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
release_cursor={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=22.0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.065, 0.09, 0.105, 1)
